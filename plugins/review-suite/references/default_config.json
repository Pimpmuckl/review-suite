{
  "version": 1,
  "privacy": {
    "arena_external_publish_enabled": false
  },
  "lens": {
    "default": {
      "model": "gpt-5.5",
      "reasoning_effort": "medium",
      "service_tier": null
    },
    "review-plan": {},
    "review-deslop": {},
    "review-followup": {
      "model": "gpt-5.6-sol",
      "reasoning_effort": "medium"
    }
  },
  "arena": {
    "enabled": false
  },
  "orchestrator": {
    "selection": "auto",
    "calibration": {
      "auto_promotion_enabled": false
    },
    "stable_defaults": {
      "discovery_brief_model": "gpt-5.4-medium",
      "discovery_deep_model": "gpt-5.4-xhigh",
      "discovery_loops": 1,
      "normal_discovery_loops": 3,
      "normal_arena_loops": 0,
      "deep_discovery_loops": 2,
      "deep_arena_loops": 0,
      "signoff_brief_model": "gpt-5.6-sol-medium",
      "signoff_deep_model": "gpt-5.6-sol-xhigh"
    },
    "profiles": {
      "stable": {
        "brief": {
          "deslop_enabled": true,
          "steps": [
            {"name": "broad-discovery", "count": 4, "model_ref": "discovery_brief_model"},
            {"name": "precision-signoff", "count": 2, "model_ref": "signoff_brief_model", "rerun_on_findings": true}
          ]
        },
        "normal": {
          "deslop_enabled": true,
          "steps": [
            {"kind": "arena", "name": "arena-phase-review", "lane": "review_t1", "task_class": "phase_review", "loop_ref": "normal_arena_loops", "enabled_ref": "arena.enabled"},
            {"name": "broad-discovery", "count": 4, "model_ref": "discovery_brief_model", "loop_ref": "normal_discovery_loops", "subtract_loop_ref": "normal_arena_loops", "subtract_if": "arena.enabled", "min_loops": 1},
            {"name": "precision-signoff", "count": 2, "model_ref": "signoff_brief_model", "rerun_on_findings": true}
          ]
        },
        "deep": {
          "deslop_enabled": true,
          "steps": [
            {"kind": "arena", "name": "arena-phase-review", "lane": "review_t1", "task_class": "phase_review", "loop_ref": "normal_arena_loops", "enabled_ref": "arena.enabled"},
            {"name": "broad-discovery", "count": 4, "model_ref": "discovery_brief_model", "loop_ref": "normal_discovery_loops", "subtract_loop_ref": "normal_arena_loops", "subtract_if": "arena.enabled", "min_loops": 1},
            {"name": "precision-signoff", "count": 2, "model_ref": "signoff_brief_model", "rerun_on_findings": true},
            {"kind": "arena", "name": "arena-pr-review", "lane": "review_t3", "task_class": "pr_review", "loop_ref": "deep_arena_loops", "enabled_ref": "arena.enabled"},
            {"name": "deep-discovery", "count": 2, "model_ref": "discovery_deep_model", "loop_ref": "deep_discovery_loops", "subtract_loop_ref": "deep_arena_loops", "subtract_if": "arena.enabled", "min_loops": 1},
            {"name": "deep-signoff", "count": 2, "model_ref": "signoff_deep_model", "rerun_on_findings": true}
          ]
        },
        "emergency": {
          "deslop_enabled": false,
          "steps": [
            {"name": "urgent-signoff", "count": 2, "model_ref": "signoff_brief_model", "max_review_rounds": 2}
          ]
        }
      }
    }
  },
  "gates": {
    "phase_gate": {
      "discovery_model_ref": "discovery_brief_model",
      "discovery_reviewer_count": 4,
      "signoff_model_ref": "signoff_brief_model",
      "signoff_reviewer_count": 2,
      "discovery_loops_ref": "discovery_loops",
      "backup_variant_ids": ["gpt-5.5-medium", "gpt-5.4-medium", "gpt-5.4-high"],
      "max_active_reviewers": 4
    },
    "pr_gate": {
      "discovery_model_ref": "discovery_deep_model",
      "discovery_reviewer_count": 2,
      "signoff_model_ref": "signoff_deep_model",
      "signoff_reviewer_count": 2,
      "discovery_loops_ref": "discovery_loops",
      "backup_variant_ids": ["gpt-5.5-xhigh", "gpt-5.4-xhigh", "gpt-5.4-high"],
      "max_active_reviewers": 2
    }
  }
}

  "orchestrator": {
    "selection": "auto",
    "calibration": {
      "auto_promotion_enabled": false
    },
    "stable_defaults": {
      "discovery_phase_model": "gpt-5.5-medium",
      "discovery_deep_model": "gpt-5.5-xhigh",
      "discovery_loops": 1,
      "normal_arena_loops": 13,
      "deep_arena_loops": 13,
      "signoff_normal_model": "gpt-5.6-sol-medium",
      "signoff_deep_model": "gpt-5.6-sol-xhigh"
    },
    "profiles": {
      "stable": {
        "normal": {
          "steps": [
            {"kind": "arena", "name": "arena-phase-review", "lane": "review_t1", "task_class": "phase_review", "pool": "arena_phase", "loop_ref": "normal_arena_loops", "enabled_ref": "arena.enabled"},
            {"name": "precision-signoff", "count": 2, "model_ref": "signoff_normal_model", "rerun_on_findings": true}
          ]
        },
        "deep": {
          "steps": [
            {"name": "precision-signoff", "count": 2, "model_ref": "signoff_normal_model", "rerun_on_findings": true},
            {"kind": "arena", "name": "arena-pr-review", "lane": "review_t3", "task_class": "pr_review", "pool": "arena_deep", "loop_ref": "deep_arena_loops", "enabled_ref": "arena.enabled"},
            {"name": "deep-signoff", "count": 2, "model_ref": "signoff_deep_model", "rerun_on_findings": true}
          ]
        },
        "fast": {
          "steps": [
            {"name": "fast-signoff", "count": 2, "model_ref": "signoff_normal_model", "max_review_rounds": 2}
          ]
        }
      }
    }
  },
  "gates": {
    "phase_gate": {
      "discovery_model_ref": "discovery_phase_model",
      "discovery_reviewer_count": 4,
      "signoff_model_ref": "signoff_normal_model",
      "signoff_reviewer_count": 2,
      "discovery_loops_ref": "discovery_loops",
      "backup_variant_ids": ["gpt-5.5-medium", "gpt-5.6-sol-medium", "gpt-5.6-terra-medium"],
      "max_active_reviewers": 4
    },
    "pr_gate": {
      "discovery_model_ref": "discovery_deep_model",
      "discovery_reviewer_count": 2,
      "signoff_model_ref": "signoff_deep_model",
      "signoff_reviewer_count": 2,
      "discovery_loops_ref": "discovery_loops",
      "backup_variant_ids": ["gpt-5.5-xhigh", "gpt-5.6-sol-xhigh", "gpt-5.6-terra-xhigh"],
      "max_active_reviewers": 2
    }
  }
}
